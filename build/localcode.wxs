<?xml version='1.0' encoding='utf-8'?>
<!--
  WiX source for the Windows MSI installer, built with msitools' `wixl`
  (works cross-platform, including on macOS — no Windows or real WiX
  Toolset needed). Version/arch/path are passed in as preprocessor
  variables from build/package-msi.sh via `wixl -D Name=Value`.

  UpgradeCode is a fixed GUID so future versions correctly upgrade
  in-place instead of installing side by side — do not change it.
-->
<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>
  <Product Name='LocalCode'
           Id='*'
           UpgradeCode='4C4C7D49-F28C-475D-923C-EB66927691A8'
           Language='1033'
           Codepage='1252'
           Version='$(var.Version)'
           Manufacturer='dennis2lee'>

    <Package Id='*'
             Keywords='Installer'
             Description='LocalCode installer'
             Comments='Bedrock + local-LLM TUI coding agent'
             Manufacturer='dennis2lee'
             InstallerVersion='450'
             Languages='1033'
             Compressed='yes'
             SummaryCodepage='1252'
             InstallScope='perMachine' />

    <MajorUpgrade DowngradeErrorMessage='A newer version of LocalCode is already installed.' />

    <Media Id='1' Cabinet='localcode.cab' EmbedCab='yes' />

    <!--
      The application icon, a multi-resolution .ico built from SVG by
      build/icon/make-ico.py. The .ico is committed rather than generated
      here on purpose: the release machine has no rasterizer, and an
      installer build must not depend on one being installed.
    -->
    <Icon Id='LocalCodeIcon' SourceFile='$(var.IconPath)' />
    <!-- Add/Remove Programs shows it too, rather than a generic box. -->
    <Property Id='ARPPRODUCTICON' Value='LocalCodeIcon' />

    <Directory Id='TARGETDIR' Name='SourceDir'>
      <Directory Id='ProgramFiles64Folder'>
        <Directory Id='INSTALLDIR' Name='LocalCode'>
          <Component Id='MainExecutable' Guid='*'>
            <File Id='LocalCodeEXE' Name='localcode.exe' Source='$(var.ExePath)' KeyPath='yes' />
            <Environment Id='PathEnv' Name='PATH' Value='[INSTALLDIR]' Permanent='no' Part='last' Action='set' System='yes' />
          </Component>
          <Component Id='GuiExecutable' Guid='*'>
            <File Id='LocalCodeGuiEXE' Name='localcode-gui.exe' Source='$(var.GuiExePath)' KeyPath='yes' />
          </Component>
          <!--
            Speech dictation links sherpa-onnx, which on Windows is three
            DLLs loaded at run time. localcode-gui.exe will not start at
            all without them — Windows resolves imports before any of our
            code runs — so they are not optional extras but part of the
            executable's contract. They come from the same CI artifact as
            the exe, built against the same version.
          -->
          <Component Id='SherpaRuntime' Guid='*'>
            <File Id='SherpaCAPIDLL' Name='sherpa-onnx-c-api.dll' Source='$(var.SherpaDir)/sherpa-onnx-c-api.dll' KeyPath='yes' />
            <File Id='SherpaCXXAPIDLL' Name='sherpa-onnx-cxx-api.dll' Source='$(var.SherpaDir)/sherpa-onnx-cxx-api.dll' />
            <File Id='OnnxRuntimeDLL' Name='onnxruntime.dll' Source='$(var.SherpaDir)/onnxruntime.dll' />
          </Component>
          <!--
            The GUI window needs the WebView2 runtime. Windows 11 and
            recent Windows 10 ship it already; older systems do not.
            Install Microsoft's official Evergreen Bootstrapper (a ~2MB
            downloader/installer, not the full runtime) alongside the
            binaries and run it silently below, so localcode-gui.exe
            works out of the box either way.
          -->
          <Component Id='WebView2BootstrapperFile' Guid='*'>
            <File Id='WebView2BootstrapperEXE' Name='MicrosoftEdgeWebview2Setup.exe' Source='$(var.WebView2BootstrapperPath)' KeyPath='yes' />
          </Component>
        </Directory>
      </Directory>

      <Directory Id='ProgramMenuFolder'>
        <Directory Id='AppMenuFolder' Name='LocalCode'>
          <Component Id='StartMenuShortcut' Guid='*'>
            <Shortcut Id='LocalCodeStartMenuShortcut'
                      Name='LocalCode'
                      Description='Bedrock + local-LLM TUI coding agent'
                      Target='[INSTALLDIR]localcode.exe'
                      Icon='LocalCodeIcon'
                      WorkingDirectory='INSTALLDIR' />
            <RemoveFolder Id='RemoveAppMenuFolder' On='uninstall' />
            <RegistryValue Root='HKCU'
                            Key='Software\LocalCode'
                            Name='installed'
                            Type='integer'
                            Value='1'
                            KeyPath='yes' />
          </Component>
          <Component Id='GuiStartMenuShortcut' Guid='*'>
            <Shortcut Id='LocalCodeGuiStartMenuShortcut'
                      Name='LocalCode (Desktop)'
                      Description='LocalCode in a native desktop window'
                      Target='[INSTALLDIR]localcode-gui.exe'
                      Arguments='--gui'
                      Icon='LocalCodeIcon'
                      WorkingDirectory='INSTALLDIR' />
            <RegistryValue Root='HKCU'
                            Key='Software\LocalCode'
                            Name='gui_installed'
                            Type='integer'
                            Value='1'
                            KeyPath='yes' />
          </Component>
        </Directory>
      </Directory>

      <!--
        The desktop shortcut points at localcode-gui.exe, not the console
        binary: a desktop icon is double-clicked from Explorer, and the
        console build launched that way opens a terminal window rather
        than the app. The Start-menu entries keep offering both.
      -->
      <Directory Id='DesktopFolder' Name='Desktop'>
        <Component Id='DesktopShortcut' Guid='*'>
          <Shortcut Id='LocalCodeDesktopShortcut'
                    Name='LocalCode'
                    Description='LocalCode in a native desktop window'
                    Target='[INSTALLDIR]localcode-gui.exe'
                    Icon='LocalCodeIcon'
                    WorkingDirectory='INSTALLDIR' />
          <RegistryValue Root='HKCU'
                          Key='Software\LocalCode'
                          Name='desktop_shortcut'
                          Type='integer'
                          Value='1'
                          KeyPath='yes' />
        </Component>
      </Directory>
    </Directory>

    <!--
      Run the bundled bootstrapper silently after files land, elevated
      (perMachine install, Impersonate='no') since it installs a
      machine-wide runtime. Return='ignore' so a machine with no internet
      access, or the runtime already present, does not fail the whole
      install over this step.
    -->
    <CustomAction Id='InstallWebView2Runtime'
                  FileKey='WebView2BootstrapperEXE'
                  ExeCommand='/silent /install'
                  Execute='deferred'
                  Return='ignore'
                  Impersonate='no' />

    <!--
      "$WebView2BootstrapperFile=3" means "only when that component's action
      state for this transaction is INSTALLSTATE_LOCAL", i.e. only when the
      bootstrapper is actually being installed right now.

      Without it, upgrading over an existing install fails with MSI error
      2753, "The File '...' is not marked for installation". A FileKey
      custom action resolves through the File table, and Windows refuses it
      whenever the referenced file's component is not part of the current
      install — which happens on an upgrade, because the bootstrapper is
      already on disk from the previous version and file-versioning rules
      decide it doesn't need replacing. Retrying then appeared to "work"
      only because the first attempt had already removed the old product,
      leaving the file genuinely absent and therefore due for install.

      wixl offers no way out of this from the other direction: it hardcodes
      RemoveExistingProducts to run right after InstallValidate (WiX's
      MajorUpgrade/@Schedule is not implemented), so the removal always
      happens before the new files land.

      Skipping is the correct behavior, not a workaround: if the
      bootstrapper is not being installed, an earlier install already ran
      it and the runtime is present.

      The "$$" is an escape, not a typo. wixl's preprocessor consumes a
      lone "$" and silently emits nothing for it, so "$Component" would
      reach the MSI as "Component" — a reference to an undefined *property*
      rather than a component action state, making the condition always
      false and disabling the custom action without a word. package-msi.sh
      checks the built MSI for the resolved condition to catch that.
    -->
    <InstallExecuteSequence>
      <Custom Action='InstallWebView2Runtime' After='InstallFiles'>NOT REMOVE AND $$WebView2BootstrapperFile=3</Custom>
    </InstallExecuteSequence>

    <Feature Id='Complete' Level='1'>
      <ComponentRef Id='MainExecutable' />
      <ComponentRef Id='StartMenuShortcut' />
      <ComponentRef Id='GuiExecutable' />
      <ComponentRef Id='SherpaRuntime' />
      <ComponentRef Id='GuiStartMenuShortcut' />
      <ComponentRef Id='DesktopShortcut' />
      <ComponentRef Id='WebView2BootstrapperFile' />
    </Feature>
  </Product>
</Wix>
