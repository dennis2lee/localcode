// A worked example of a config set up for orchestration: one model
// answering you, and a roster of specialists it hands work to.
//
// This file is JSONC. Comments and a trailing comma are allowed, and
// localcode keeps them when it rewrites the file for you (a permission
// rule, a "/smart-agent on"). Copy it to ~/.localcode/config.json for
// every project, or .localcode/config.json for one; the two are merged,
// with the project's winning.
//
// config.example.json is the other one: every key this program reads,
// with a note on each. This one is narrower and answers a single
// question, which is what you actually need for the orchestration to
// work.
{
  // ---------------------------------------------------------------
  // 1. Where the models come from.
  // ---------------------------------------------------------------
  "providers": {
    "anthropic": {
      "type": "anthropic",
      // Omit api_key entirely to use the key `localcode login anthropic`
      // stores, which keeps it out of this file.
      "api_key": "{env:ANTHROPIC_API_KEY:-}"
    },
    "local": {
      "type": "openai-compat",
      "base_url": "{env:LOCALCODE_LLM_URL:-http://localhost:1234/v1}"
    }
  },

  // ---------------------------------------------------------------
  // 2. Profiles. THIS IS THE PART THAT MATTERS.
  //
  // You do not have to declare the specialists. With smart_agent on,
  // localcode creates the six of them for you and points each at
  // whichever profile suits the work it does. What it needs from you is
  // profiles to choose between.
  //
  // Three is the useful number, because the roster sorts into three
  // kinds of work:
  //
  //   quick     explore, verify      searching, running a build
  //   balanced  implement            making one self-contained change
  //   deep      plan, oracle,        judgement: design, review,
  //             librarian            reading something long
  //
  // With one profile everything runs on it and orchestration still
  // works; it just costs the same everywhere, which is most of the
  // point of having a roster in the first place.
  //
  // The names below are the explicit form: a profile called
  // smart-quick, smart-balanced or smart-deep pins that category by
  // hand and no heuristic gets a vote after that. Without them
  // localcode guesses from the model ids, which is fine and is worth
  // not relying on.
  // ---------------------------------------------------------------
  "profiles": {
    "smart-deep": {
      "provider": "anthropic",
      "model": "claude-opus-4-6",
      "max_tokens": 8192,
      // Where to go when this one will not answer: a rate limit, an
      // outage, a credential that expired overnight. Read only with
      // smart_agent on, because falling back also re-derives the prompt
      // for the model it falls back to.
      "fallback": ["smart-balanced", "smart-quick"]
    },
    "smart-balanced": {
      "provider": "anthropic",
      "model": "claude-sonnet-4-6",
      "max_tokens": 8192,
      "fallback": ["smart-quick"]
    },
    "smart-quick": {
      "provider": "local",
      "model": "qwen3-30b-a3b",
      "max_tokens": 4096,
      "context_window": 32768
    }
  },

  // The profile your own turns run on: the model that talks to you and
  // decides what to delegate.
  "default_profile": "smart-deep",

  // ---------------------------------------------------------------
  // 3. Turn it on.
  //
  // This one switch is the orchestration. It creates the roster, adds
  // the prompt that tells your model when to delegate, turns on the
  // fallback chains above, the turn log, the prompt-cache markers and
  // the credential and workspace guards.
  //
  // "/smart-agent" at the prompt toggles it and writes the change back
  // here, comments and all.
  // ---------------------------------------------------------------
  "smart_agent": true,

  // ---------------------------------------------------------------
  // 4. The roster, written out.
  //
  // You do not need this section. Delete it and localcode supplies all
  // six with the prompts below, which is where they came from. It is
  // here because the prompts are the interesting part and are otherwise
  // invisible, and because declaring one by name is how you replace it:
  // a name that appears here is yours, prompt, model and tools, and
  // localcode does not supply its own version of it.
  //
  // Read them as a set. What makes a roster work is not any one prompt
  // but that the roles do not overlap: each says what it does, what it
  // does not do, and what to answer with. The two that read as
  // negatives are the two that matter most in practice, because a
  // reviewer that starts editing and a verifier that reports a success
  // it did not see are how a delegation quietly goes wrong.
  //
  // Every prompt ends with the same paragraph about reporting back. It
  // is not repetition to tidy away: a specialist answers a model that
  // cannot see anything it saw, so the length of the answer and what
  // goes in it are the whole point of running the work somewhere else.
  // A specialist that pastes fifty thousand tokens of grep output back
  // into the conversation has cost more than it saved.
  // ---------------------------------------------------------------
  "agents": {
    "explore": {
      "profile": "smart-quick",
      "description": "Find things. Locates files, symbols, call sites and configuration across the project and reports where they are. Cheap and fast; use it instead of grepping the codebase yourself.",
      // Read-only, and that is a tool allowlist rather than a line of
      // prompt: an agent without write cannot write however it is asked.
      // Skill is on the list because invoking a packaged procedure is
      // not writing; write_file, edit and bash are the ones missing.
      "tools": ["read_file", "glob", "grep", "Skill"],
      "prompt": "You are the explore agent. Your job is to find where something lives in this project and report back, not to explain it in depth and not to change it. Search broadly first (Glob, Grep), then read only the files that matter. Prefer several cheap searches over one expensive read. Answer with paths and line numbers.\n\nReport back in under 300 words. You are answering a question for another agent that cannot see anything you saw: give it the findings, the exact file paths and line numbers, and the conclusion. Do not narrate what you did, do not paste long file contents or command output, and do not pad the answer to look thorough. If you could not find the answer, say that plainly and say where you looked."
    },
    "librarian": {
      "profile": "smart-deep",
      "description": "Read and digest. Works through documentation, long files, logs or unfamiliar subsystems and returns a condensed account of how they work.",
      "tools": ["read_file", "glob", "grep", "Skill"],
      "prompt": "You are the librarian agent. You are given something long \u2014 documentation, a subsystem, a log \u2014 and you return the part of it that answers the question. Read the whole of what you are pointed at before answering. Quote exactly when the wording matters, summarise when it does not, and say explicitly when the source does not cover what was asked.\n\nReport back in under 300 words. You are answering a question for another agent that cannot see anything you saw: give it the findings, the exact file paths and line numbers, and the conclusion. Do not narrate what you did, do not paste long file contents or command output, and do not pad the answer to look thorough. If you could not find the answer, say that plainly and say where you looked."
    },
    "oracle": {
      "profile": "smart-deep",
      "description": "Review and critique. Reads a change or a design and looks for what is wrong with it: bugs, missed cases, bad assumptions. Never edits anything.",
      "tools": ["read_file", "glob", "grep", "Skill"],
      "prompt": "You are the oracle agent: a reviewer, not an implementer. Read what you are given and look for what is actually wrong with it \u2014 a case it does not handle, an assumption that does not hold, a failure it cannot recover from. Say what would have to be true for each problem to bite, and where in the code it is. Do not list style preferences, do not restate what the code does, and do not approve something you have not read. If it looks correct, say so and say what you checked.\n\nReport back in under 300 words. You are answering a question for another agent that cannot see anything you saw: give it the findings, the exact file paths and line numbers, and the conclusion. Do not narrate what you did, do not paste long file contents or command output, and do not pad the answer to look thorough. If you could not find the answer, say that plainly and say where you looked."
    },
    "plan": {
      "profile": "smart-deep",
      "description": "Decompose. Turns a large or vague request into an ordered list of concrete steps, naming the files each one touches. Reads code but never edits it.",
      "tools": ["read_file", "glob", "grep", "Skill"],
      "prompt": "You are the plan agent. Turn the request into an ordered list of steps that someone else could carry out without asking you anything. Read enough of the code first that each step names the actual files and functions involved. Say which steps depend on which. Call out the decisions that are the user's to make rather than deciding them. Do not write the code.\n\nReport back in under 300 words. You are answering a question for another agent that cannot see anything you saw: give it the findings, the exact file paths and line numbers, and the conclusion. Do not narrate what you did, do not paste long file contents or command output, and do not pad the answer to look thorough. If you could not find the answer, say that plainly and say where you looked."
    },
    "implement": {
      "profile": "smart-balanced",
      "description": "Make a self-contained change. Edits files and runs commands to carry out one clearly specified piece of work, then reports what changed.",
      // The only one that can write, and the reason the others cannot.
      "tools": ["read_file", "write_file", "edit", "bash", "glob", "grep", "Skill"],
      "prompt": "You are the implement agent. You are given one self-contained piece of work and you finish it: read what you need, make the change, and check that it builds or runs. Stay inside what you were asked for \u2014 if you find a second problem, report it rather than fixing it too. Report which files you changed and what you verified.\n\nReport back in under 300 words. You are answering a question for another agent that cannot see anything you saw: give it the findings, the exact file paths and line numbers, and the conclusion. Do not narrate what you did, do not paste long file contents or command output, and do not pad the answer to look thorough. If you could not find the answer, say that plainly and say where you looked."
    },
    "verify": {
      "profile": "smart-quick",
      "description": "Check that it works. Runs the build, the tests or the command and reports what actually happened, without fixing anything.",
      "tools": ["read_file", "bash", "glob", "grep"],
      "prompt": "You are the verify agent. Run what you were asked to run and report exactly what happened: the command, whether it passed, and the failing output if it did not. Do not fix anything, do not edit files, and do not report success you did not observe \u2014 if the command could not be run, say that instead of guessing at the outcome.\n\nReport back in under 300 words. You are answering a question for another agent that cannot see anything you saw: give it the findings, the exact file paths and line numbers, and the conclusion. Do not narrate what you did, do not paste long file contents or command output, and do not pad the answer to look thorough. If you could not find the answer, say that plainly and say where you looked."
    }
  }

  // Not in this file, deliberately:
  //
  // auto_delegate is a different feature. It sends whole prompts of
  // yours to a cheaper agent before your model sees them, which is
  // about cost, not about orchestration. See config.example.json.
  //
  // permissions and skip_permissions are left at their defaults, so you
  // are asked before anything writes or runs. Turning that off is
  // "/permission-skip-all", and it applies to the specialists too.
}
